{
  "context": "kind-astro-ats-031-lab-010-01-01",
  "cluster": "astro-ats-031-lab-010-01-01",
  "namespace": "starfleet-031-010-01-01",
  "resources": [
    {
      "kind": "networkpolicy",
      "name": "probe-shuttle",
      "expected": {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "NetworkPolicy",
        "metadata": {
          "name": "probe-shuttle",
          "namespace": "starfleet-031-010-01-01"
        },
        "spec": {
          "podSelector": {
            "matchLabels": {
              "app": "probe"
            }
          },
          "policyTypes": [
            "Ingress"
          ],
          "ingress": [
            {
              "from": [
                {
                  "podSelector": {
                    "matchLabels": {
                      "app": "shuttle"
                    }
                  }
                }
              ],
              "ports": [
                {
                  "protocol": "TCP",
                  "port": 8080
                }
              ]
            }
          ]
        }
      },
      "outcome": "probe-shuttle-policy"
    },
    {
      "kind": "deployment",
      "name": "probe",
      "expected": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "probe",
          "namespace": "starfleet-031-010-01-01"
        },
        "spec": {
          "replicas": 2,
          "selector": {
            "matchLabels": {
              "app": "probe",
              "release": "probe"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "app": "probe",
                "release": "probe"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "probe",
                  "image": "docker.io/library/python:3.13-alpine",
                  "command": [
                    "python",
                    "/app/server.py"
                  ],
                  "env": [
                    {
                      "name": "VERSION",
                      "value": "v1"
                    }
                  ],
                  "ports": [
                    {
                      "name": "http",
                      "containerPort": 8080
                    }
                  ],
                  "readinessProbe": {
                    "httpGet": {
                      "path": "/ready",
                      "port": "http"
                    },
                    "periodSeconds": 2
                  },
                  "resources": {
                    "requests": {
                      "cpu": "10m",
                      "memory": "32Mi"
                    },
                    "limits": {
                      "memory": "128Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "app",
                      "mountPath": "/app",
                      "readOnly": true
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "app",
                  "configMap": {
                    "name": "probe-code"
                  }
                }
              ]
            }
          }
        }
      },
      "state": "deployment"
    },
    {
      "kind": "pod",
      "name": "shuttle",
      "expected": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "shuttle",
          "namespace": "starfleet-031-010-01-01",
          "labels": {
            "app": "shuttle"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "client",
              "image": "docker.io/library/busybox:1.37.0",
              "command": [
                "sh",
                "-c",
                "sleep 3600"
              ]
            }
          ],
          "restartPolicy": "Never"
        }
      },
      "state": "pod"
    },
    {
      "kind": "pod",
      "name": "drifter",
      "expected": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "drifter",
          "namespace": "outpost-031-010-01-01",
          "labels": {
            "app": "drifter"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "client",
              "image": "docker.io/library/busybox:1.37.0",
              "command": [
                "sh",
                "-c",
                "sleep 3600"
              ]
            }
          ],
          "restartPolicy": "Never"
        }
      },
      "state": "pod",
      "namespace": "outpost-031-010-01-01"
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet-031-010-01-01",
        "exec",
        "shuttle",
        "--",
        "wget",
        "-q",
        "-T",
        "3",
        "-O-",
        "http://probe/"
      ],
      "contains": [
        "version=v1"
      ],
      "outcome": "drifter-denied"
    },
    {
      "args": [
        "kubectl",
        "-n",
        "outpost-031-010-01-01",
        "exec",
        "drifter",
        "--",
        "wget",
        "-q",
        "-T",
        "3",
        "-O-",
        "http://probe.starfleet-031-010-01-01/"
      ],
      "denied": true,
      "failure_markers": [
        "timed out"
      ],
      "outcome": "drifter-denied"
    }
  ]
}
