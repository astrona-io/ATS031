apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: scout-egress
  namespace: dock
spec:
  podSelector:
    matchLabels:
      app: scout
  policyTypes:
  - Egress
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
      podSelector:
        matchLabels:
          k8s-app: kube-dns
    ports:
    - protocol: UDP
      port: 53
    - protocol: TCP
      port: 53
  - to:
    - ipBlock:
        cidr: <API_ADDRESS>/32
    ports:
    - protocol: TCP
      port: <API_PORT>
